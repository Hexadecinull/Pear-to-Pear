# Copy to .env.production (or .env) before running `npm run build` if you
# want to override the defaults baked into the client bundle. All of these
# are read at BUILD time (Vite inlines them into the static JS), not at
# runtime — rebuild the client after changing them.

# WebSocket URL of the signaling/relay server. Leave unset in production to
# auto-derive it from the page's own origin (recommended: it means the
# client always talks back to whatever domain served it, no matter what
# domain you deploy to). Only set this explicitly for local development
# against a server running on a different port, e.g.:
# VITE_SIGNALING_URL=ws://localhost:8787
VITE_SIGNALING_URL=

# Comma-separated list of STUN server URLs used only to attempt a direct
# (true peer-to-peer) WebRTC connection before falling back to the relay.
# STUN servers never see file data — they only help a peer learn its own
# public address for NAT traversal. The default below points at a public
# Google STUN server, matching what nearly all WebRTC apps use so this
# works out of the box. Point it at your own coturn instance (UDP 3478)
# instead if you'd rather not depend on a third party for this step —
# see docs/ARCHITECTURE.md for why this is optional in the first place.
VITE_STUN_URLS=stun:stun.l.google.com:19302
