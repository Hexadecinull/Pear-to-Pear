# Copy this file to .env and adjust as needed.
# The server reads these at boot (see src/config.ts). Every value has a
# sane default, so an empty .env is a valid, working configuration.

# TCP port the HTTP + WebSocket server listens on.
PORT=8787

# Directory of the built client (output of `npm run build` inside /client).
# Served as static files at "/". Leave unset to disable static serving
# (useful if you host the frontend separately, e.g. on a CDN).
#
# IMPORTANT: leave this commented out if you're using the provided
# Docker image (docker-compose.yml / Dockerfile), the image already
# sets this correctly for its own internal filesystem layout
# (STATIC_DIR=./client-dist, baked in by the Dockerfile), and this .env
# file is loaded into the container via env_file, so an active value
# here would silently override that and break static serving. Only
# uncomment this if you're running the server directly (bare metal /
# systemd, see docs/DEPLOY.md Option B), where it's relative to
# wherever you run `node dist/index.js` from (typically server/):
# STATIC_DIR=../client/dist

# Hard caps enforced server-side, independent of what the client enforces.
# These exist so a modified/malicious client can never exceed them.
MAX_FILES_PER_TRANSFER=500
MAX_TOTAL_BYTES=10737418240
# ^ 10 GiB (10 * 1024^3). Change this if you want a different cap.

# Maximum bytes allowed "in flight" (received from the sender but not yet
# acknowledged as forwarded to the receiver) per session. This is the knob
# that keeps memory use flat no matter how large the transfer is. Lower it
# on memory-constrained hosts, raise it on high-bandwidth links.
MAX_INFLIGHT_BYTES_PER_SESSION=16777216
# ^ 16 MiB

# How long an unbonded peer code may sit idle (no bond attempt) before the
# server closes the socket and frees the code, in milliseconds.
CODE_IDLE_TIMEOUT_MS=1800000
# ^ 30 minutes

# How long a code's owner has to accept or decline an incoming connection
# request before it's treated as declined automatically, in milliseconds.
PENDING_BOND_TIMEOUT_MS=30000
# ^ 30 seconds

# Simple per-IP connection rate limit (token bucket).
RATE_LIMIT_MAX_CONNECTIONS_PER_MINUTE=30

# Comma-separated list of origins allowed to open a WebSocket connection.
# Set to "*" only for local development. In production, set this to your
# real domain(s), e.g. https://pear.example.com
ALLOWED_ORIGINS=*

# Trust the X-Forwarded-For header for client IPs (needed behind Cloudflare
# Tunnel / any reverse proxy). Only enable this if you actually run behind
# a trusted proxy, otherwise clients could spoof their rate-limit identity.
TRUST_PROXY=true
