[Unit]
Description=Pear-to-Pear GitHub webhook auto-deploy listener
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/pear-to-pear/deploy/webhook
EnvironmentFile=/opt/pear-to-pear/deploy/webhook/.env
ExecStart=/usr/bin/node listener.mjs
Restart=on-failure
RestartSec=2

# User=CHANGE_ME below is a deliberate fail-fast default: a fresh
# install with no override configured refuses to start with a clear
# systemd status 217/USER, rather than silently running as root.
#
# Do NOT edit this line to set your real user, though. Every time you
# update (`git pull` then `cp` this file over the installed copy), that
# edit is silently lost, reverting back to CHANGE_ME and breaking the
# service again. Instead, set your real user in a systemd drop-in,
# which overrides this value and survives this file being replaced
# wholesale. See deploy/webhook/override.conf.example and
# docs/DEPLOY.md ("Decide which user the listener runs as").
User=CHANGE_ME

# This process (unlike the main app's unit) genuinely needs to write:
# deploy.sh does a `git reset --hard` and rebuilds inside REPO_DIR, so
# it does NOT use ProtectSystem=strict. ReadWritePaths grants exactly
# the one directory it needs.
#
# No ProtectHome here on purpose: Docker Compose can depend on files
# under the deploying user's home directory (~/.docker/config.json,
# per-user CLI plugins, credential helpers). Hiding /home made `docker
# compose` behave differently under this service than it does in an
# interactive shell as the same user, which is exactly the kind of gap
# that turns into "works when I test it, silently doesn't when the
# webhook fires." If you don't need Docker (DEPLOY_MODE=systemd) and
# want the extra hardening back, ProtectHome=read-only is a safer
# middle ground than =true: it still blocks writes to $HOME.
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/opt/pear-to-pear

[Install]
WantedBy=multi-user.target
