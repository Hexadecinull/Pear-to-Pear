# Copy to .env next to listener.mjs. This process is loaded via
# EnvironmentFile= in the systemd unit (see pear-to-pear-webhook.service),
# so this is plain KEY=VALUE, no quoting needed for simple values.

# Required. A long random shared secret — generate with:
#   openssl rand -hex 32
# Enter the exact same value as the webhook's "Secret" field on GitHub
# (repo Settings -> Webhooks). Anyone who has this can trigger a deploy,
# so treat it like a password.
WEBHOOK_SECRET=

# Port this listener binds to. Only needs to be reachable from wherever
# your reverse proxy / tunnel forwards GitHub's webhook requests to —
# see docs/DEPLOY.md for wiring this up alongside the main app without
# opening a second public port.
WEBHOOK_PORT=9000

# Which push triggers a deploy. This project's default branch is
# "master", not "main" — change this if yours differs.
WEBHOOK_BRANCH_REF=refs/heads/master

# Passed through to deploy.sh:
REPO_DIR=/opt/pear-to-pear
DEPLOY_MODE=docker
